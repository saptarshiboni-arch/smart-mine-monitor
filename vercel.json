{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/authentication-admin/:path*",
      "destination": "/authentication-admin/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
