# MINEGUARD AI — Backend Environment Configuration

# URL of the separate FastAPI ML Service exposing /predict
# Default: http://localhost:8000 (or whichever host/port your ML server runs on)
ML_API_URL=http://localhost:8000

# Server host and port for this backend service
HOST=0.0.0.0
PORT=8000

# Optional API key for ESP32 / LoRa gateway authentication (X-API-Key header)
# Leave blank to allow unauthenticated local development
MINEGUARD_API_KEY=

# Optional CORS origins (comma-separated, default is all: *)
CORS_ORIGINS=*
